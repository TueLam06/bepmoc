{
  "name": "bepmoc-server",
  "version": "1.0.0",
  "description": "REST API Express + PostgreSQL cho web bán hàng Bếp Mộc Linh Đan",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "seed": "node scripts/seed.js",
    "upload-images": "node scripts/upload-images.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TueLam06/bepmoc.git",
    "directory": "server"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/afterEnv.js"
    ]
  }
}
